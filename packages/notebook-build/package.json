{
  "name": "@statewalker/notebook-build",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Build notebooks from a FilesApi into a static site of executable notebook pages.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-browser.json",
    "test:browser": "pnpm --filter @statewalker/notebook-db run build && vitest run test-browser --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@observablehq/notebook-kit": "^2.6.4",
    "markdown-it": "catalog:"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@statewalker/db-duckdb-browser": "workspace:*",
    "@statewalker/notebook-db": "workspace:*",
    "@statewalker/webrun-files-mem": "workspace:*",
    "@statewalker/webrun-files-node": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/markdown-it": "catalog:",
    "esbuild": "^0.28.2",
    "jsdom": "catalog:",
    "playwright": "^1.63.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@statewalker/webrun-builder": "workspace:*",
    "@statewalker/webrun-files": "workspace:*",
    "@statewalker/webrun-modules": "workspace:*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
