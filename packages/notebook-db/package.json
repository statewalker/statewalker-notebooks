{
  "name": "@statewalker/notebook-db",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Back notebook-kit SQL cells with any @statewalker/db-api database.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "test:browser": "vitest run test-browser --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-browser.json"
  },
  "dependencies": {
    "@observablehq/notebook-kit": "^2.6.4"
  },
  "peerDependencies": {
    "@statewalker/db-api": "workspace:*",
    "@statewalker/webrun-files": "workspace:*"
  },
  "devDependencies": {
    "@statewalker/db-api": "workspace:*",
    "@statewalker/db-duckdb-browser": "workspace:*",
    "@statewalker/webrun-files": "workspace:*",
    "@statewalker/webrun-files-mem": "workspace:*",
    "@statewalker/webrun-files-node": "workspace:*",
    "@statewalker/webrun-modules": "workspace:*",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
