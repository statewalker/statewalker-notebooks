{
  "name": "@statewalker/notebook-site",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Compose a SiteHandler serving a built notebook site: pages, module dependencies and the rebuild event stream.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/notebook-events": "workspace:*"
  },
  "peerDependencies": {
    "@statewalker/webrun-files": "workspace:*",
    "@statewalker/webrun-site-builder": "workspace:*"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
